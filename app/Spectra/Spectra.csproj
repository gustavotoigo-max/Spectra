<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>Spectra</AssemblyName>
    <RootNamespace>Spectra</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Spectra</Product>
    <Description>Transmissão de tela para o seu grupo</Description>
    <VersionPrefix>0.1.0</VersionPrefix>

    <!-- Publicação: um único Spectra.exe, sem precisar instalar o .NET. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- A interface (HTML/CSS/JS) vai embutida no executável e é servida por WebResourceRequested. -->
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
