# Gerado automaticamente pelo install.sh. Copie para .env só se for configurar à mão.

# Domínio público do servidor. Sem domínio próprio, use o sslip.io com o IP da VM:
# 129.146.10.20 → 129-146-10-20.sslip.io
SPECTRA_DOMAIN=129-146-10-20.sslip.io

# Chaves do LiveKit (nunca saem do servidor).
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Chave de acesso do grupo: é o que você passa para os amigos colocarem no app.
SPECTRA_ACCESS_KEY=troque-esta-chave

# Limite de tráfego de saída por mês, em GB. Ao atingir, o Spectra fica bloqueado até o dia 1º.
# A Oracle Always Free dá 10 TB; 5000 deixa uma boa margem.
SPECTRA_MONTHLY_LIMIT_GB=5000
