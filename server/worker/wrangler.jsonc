// Configuração do Worker do Spectra (plano gratuito da Cloudflare).
// Publicar: npx wrangler deploy — veja o README.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spectra",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // Durable Objects com SQLite são os que o plano gratuito permite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
